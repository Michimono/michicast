APP_NAME=Michicast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

BRAND_NAME=Michimono
SUPPORT_EMAIL=support@michicast.com

# Comma-separated emails for platform admins. Matched case-insensitively after trim.
# PLATFORM_ADMIN_EMAILS=

# Optional comma-separated IPs/CIDRs allowed to reach /admin. Empty = no IP restriction.
# ADMIN_ALLOWED_IPS=
# Admin password-confirmation window in seconds (default 900 = 15 minutes).
# ADMIN_PASSWORD_TIMEOUT=900

# Default registration mode: open, invite_only or closed. Admins can override it at /admin/settings.
# MICHICAST_REGISTRATION=open
# Optional cap on new accounts per UTC day; registration behaves as closed once reached.
# MICHICAST_REGISTRATION_DAILY_CAP=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Keep Boost from generating its `.ai/rules` guidance; this project uses `.cursor/rules`.
BOOST_RULES_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=michicast
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local default. Droplet Compose uses deploy/.env (QUEUE_CONNECTION=redis).
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

DISPATCH_TIME_BUDGET=50
DISPATCH_STALE_CLAIM_AFTER=120
# false keeps due projects and Run now inline (hand-installed cron / no worker).
# Droplet Compose sets true in deploy/.env so claimed runs go through Horizon.
MICHICAST_RUNS_ON_QUEUE=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Local/CI defaults. Droplet Compose uses deploy/.env (REDIS_HOST=redis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Pulse (#158): ingest via storage by default (no extra worker). Retention 7 days.
# Optional scale path: PULSE_INGEST_DRIVER=redis plus php artisan pulse:work
# (prefer PULSE_REDIS_CONNECTION on a dedicated Redis DB, not the queue connection).
# PULSE_ENABLED=true
# PULSE_INGEST_DRIVER=storage
# PULSE_STORAGE_KEEP="7 days"
# PULSE_PATH=admin/pulse
# Organization quota plans (see config/michicast.php quotas). Fetch/delivery numbers are per period (monthly by default).
# QUOTA_DEFAULT_PLAN=free
# QUOTA_ORGANIZATIONS_PER_USER=3
# QUOTA_FREE_SOURCE_FETCHES=200
# QUOTA_FREE_DELIVERIES=100
# QUOTA_FREE_ACTIVE_BROADCASTS=10
# QUOTA_FREE_SOURCES=10
# QUOTA_FREE_DESTINATIONS=5
# QUOTA_FREE_MEMBERS=5
# Period for the free plan's rate limits: daily, weekly or monthly (default monthly).
# QUOTA_FREE_SOURCE_FETCHES_PERIOD=monthly
# QUOTA_FREE_DELIVERIES_PERIOD=monthly
