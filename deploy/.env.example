APP_NAME=Michicast
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Public hostname for Caddy TLS (must match the host in APP_URL). Let's Encrypt issues for this name.
DOMAIN=example.com
# Contact email for the Let's Encrypt account / expiry notices.
ACME_EMAIL=admin@example.com

BRAND_NAME=Michimono
SUPPORT_EMAIL=support@michicast.com

# Comma-separated emails for platform admins. Matched case-insensitively after trim.
# PLATFORM_ADMIN_EMAILS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

BOOST_RULES_ENABLED=false
# true injects an inline script that the CSP blocks.
BOOST_BROWSER_LOGS_WATCHER=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=michicast
DB_USERNAME=michicast
DB_PASSWORD=change-me

# Same database and user as above. Used by the mysql image on first init only.
MYSQL_DATABASE=michicast
MYSQL_USER=michicast
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required on the public droplet: Caddy terminates TLS in front of the app.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

DISPATCH_TIME_BUDGET=50
DISPATCH_STALE_CLAIM_AFTER=120
# Claimed broadcast runs and Run now / Send latest go through Horizon.
MICHICAST_RUNS_ON_QUEUE=true

CACHE_STORE=database

# Redis (Compose service hostname). Queue uses Redis via Horizon; cache/session stay on the database.
# Generate a password when creating deploy/.env, e.g. openssl rand -base64 32
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"